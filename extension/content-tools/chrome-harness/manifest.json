{
  "manifest_version": 3,
  "name": "FOCURVE 추천 숨김 시험판 — Core 미연결",
  "version": "0.1.14",
  "permissions": ["activeTab"],
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://www.instagram.com/*", "https://instagram.com/*"], "js": ["bootstrap.js"], "run_at": "document_idle"}],
  "web_accessible_resources": [{"resources": ["content/*.mjs", "ui/restriction.mjs"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://www.instagram.com/*", "https://instagram.com/*"]}]
}
