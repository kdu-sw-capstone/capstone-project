{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "d06-a0-registry-candidate-1 — UNAPPROVED draft",
  "description": "Candidate-3 control schemas retained verbatim; new Registry persistence messages require approval. Semantic/native sender checks are mandatory outside Schema.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "safe": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "context": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/uuid"
        },
        "policy_snapshot_id": {
          "$ref": "#/$defs/uuid"
        },
        "executor_id": {
          "$ref": "#/$defs/uuid"
        },
        "navigation_id": {
          "$ref": "#/$defs/uuid"
        },
        "binding_id": {
          "$ref": "#/$defs/uuid"
        },
        "desired_revision": {
          "$ref": "#/$defs/safe"
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "session_id",
        "policy_snapshot_id",
        "executor_id",
        "navigation_id",
        "binding_id",
        "desired_revision",
        "document_id"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "string",
      "pattern": "^GUEST:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "policy": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": "1.2"
        },
        "site_match_strategy": {
          "const": "MOST_SPECIFIC_HOST"
        },
        "source_version": {
          "$ref": "#/$defs/safe"
        },
        "site_id": {
          "$ref": "#/$defs/uuid"
        },
        "site_version": {
          "$ref": "#/$defs/safe"
        },
        "target_host": {
          "const": "www.youtube.com"
        },
        "matched_policy_host": {
          "enum": [
            "youtube.com",
            "www.youtube.com"
          ]
        },
        "access_policy": {
          "const": "ALLOW"
        },
        "feature_policies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "feature_code": {
                "const": "YOUTUBE_SHORTS"
              },
              "enabled": {
                "const": true
              }
            },
            "required": [
              "feature_code",
              "enabled"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format_version",
        "site_match_strategy",
        "source_version",
        "site_id",
        "site_version",
        "target_host",
        "matched_policy_host",
        "access_policy",
        "feature_policies"
      ],
      "additionalProperties": false
    },
    "query_bootstrap": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "D06_CONTENT_CONTROL"
        },
        "owner_context": {
          "type": "null"
        },
        "payload": {
          "type": "object",
          "properties": {
            "contract_version": {
              "const": "d06-shorts-a0-candidate-3"
            },
            "operation_id": {
              "$ref": "#/$defs/uuid"
            },
            "operation": {
              "const": "QUERY"
            },
            "target_document_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "context": {
              "type": "null"
            }
          },
          "required": [
            "contract_version",
            "operation_id",
            "operation",
            "target_document_id",
            "context"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "type",
        "owner_context",
        "payload"
      ],
      "additionalProperties": false
    },
    "query_bound": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "D06_CONTENT_CONTROL"
        },
        "owner_context": {
          "$ref": "#/$defs/owner"
        },
        "payload": {
          "type": "object",
          "properties": {
            "contract_version": {
              "const": "d06-shorts-a0-candidate-3"
