              "maxLength": 200
            },
            "context": {
              "$ref": "#/$defs/context"
            },
            "content_instance_id": {
              "$ref": "#/$defs/uuid"
            }
          },
          "required": [
            "contract_version",
            "operation_id",
            "operation",
            "target_document_id",
            "context",
            "content_instance_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "type",
        "owner_context",
        "payload"
      ],
      "additionalProperties": false
    },
    "apply": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
