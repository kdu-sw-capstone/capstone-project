package kr.ac.kdu.focurve;
import com.fasterxml.jackson.databind.*;import com.fasterxml.jackson.databind.node.*;
import jakarta.servlet.http.*;import org.springframework.stereotype.Component;import org.springframework.context.annotation.Profile;
import java.util.*;import static kr.ac.kdu.focurve.MemberAuth.*;import static kr.ac.kdu.focurve.MemberIntervals.*;

@Profile("member-runtime | local-integration") @Component
class MemberAccounts {
 @org.springframework.beans.factory.annotation.Value("${member.mail.test-sink:false}") boolean testMailSink;
 @org.springframework.beans.factory.annotation.Autowired(required=false) MailOutbox externalMail;
 boolean mailConfigured(){return testMailSink||externalMail!=null&&externalMail.configured();}
 @org.springframework.beans.factory.annotation.Autowired kr.ac.kdu.focurve.auth.EmailSignupCodes signupCodes;
 final MemberAuth a;final MailRate mailRate=new MailRate();MemberAccounts(MemberAuth a){this.a=a;}
 static String email(String value){String e=value.trim().toLowerCase(Locale.ROOT);check(e.length()<=254&&e.matches("[^\\s@]+@[^\\s@]+\\.[^\\s@]+"),422,"VALIDATION_FAILED");return e;}
 static void password(String p){check(p.length()>=12&&p.length()<=128,422,"VALIDATION_FAILED");}
 ObjectNode user(long id){var row=a.one("SELECT * FROM users WHERE id=?",id);check(row!=null,401,"UNAUTHENTICATED");var providers=a.db.queryForList("SELECT provider FROM auth_identities WHERE user_id=? ORDER BY provider",String.class,id);return a.obj("user_id",Long.toString(id),"display_name",row.get("display_name"),"email",row.get("email"),"email_verified",row.get("email_verified"),"providers",providers);}
 ObjectNode session(HttpServletRequest req,HttpServletResponse res,long user){String sid=secret(),csrf=kr.ac.kdu.focurve.auth.AuthSupport.fingerprint(sid,"FOCURVE_CSRF_V1");a.db.update("DELETE FROM web_sessions WHERE id_hash=?",hash(a.cookie(req)));a.db.update("INSERT INTO web_sessions(id_hash,user_id,csrf_hash,expires_at,auth_version) VALUES(?,?,?,?,?)",hash(sid),user,hash(csrf),after(3600),a.authVersion(user));a.setCookie(res,sid);ObjectNode u=user(user);u.put("csrf_token",csrf);return u;}
 void defaults(long user){a.db.update("INSERT INTO content_policies(user_id,version,payload,updated_at,keywords,adult_domains,image_blur,usage_tracking) VALUES(?,1,?,?,?,?,?,?)",user,defaultPolicy(a).toString(),now(),defaultPolicy(a).path("keywords").toString(),defaultPolicy(a).path("adult_domains").toString(),defaultPolicy(a).path("image_blur").toString(),defaultPolicy(a).path("usage_tracking").toString());}
 static ObjectNode defaultPolicy(MemberAuth a){return a.obj("version",1,"keywords",Map.of("enabled",false,"rules",List.of(),"exceptions",List.of()),"adult_domains",Map.of("enabled",false,"custom_hosts",List.of(),"exceptions",List.of()),"image_blur",Map.of("enabled",false,"sensitivity","MEDIUM","strength","MEDIUM"),"usage_tracking",Map.of("enabled",false));}
 ObjectNode signup(HttpServletRequest req,HttpServletResponse res,JsonNode b){a.web(req,true,false);keys(b,"email","password","display_name","terms_version","verification_proof");String em=kr.ac.kdu.focurve.auth.AuthSupport.email(text(b,"email")),pw=text(b,"password"),display=text(b,"display_name"),terms=text(b,"terms_version");password(pw);check(display.length()>=1&&display.length()<=40&&!terms.isBlank()&&terms.length()<=40,422,"VALIDATION_FAILED");check(a.one("SELECT id FROM users WHERE email=? FOR UPDATE",em)==null,409,"EMAIL_IN_USE");signupCodes.consume(em,a.cookie(req),b.hasNonNull("verification_proof")?text(b,"verification_proof"):null);a.db.update("INSERT INTO users(display_name,email,email_verified,status,created_at,terms_version,terms_accepted_at) VALUES(?,?,true,'ACTIVE',?,?,?)",display,em,now(),terms,now());long id=a.db.queryForObject("SELECT id FROM users WHERE email=?",Long.class,em);a.db.update("INSERT INTO auth_identities(user_id,provider,subject,password_hash,updated_at) VALUES(?,'EMAIL',?,?,?)",id,em,a.passwords.encode(pw),now());defaults(id);return a.obj("user_id",Long.toString(id),"status","ACTIVE");}
 void mail(long user,String recipient,String kind,int expiry){check(mailConfigured(),503,"EMAIL_PROVIDER_NOT_CONFIGURED");String token=secret(),cid=id();a.db.update("INSERT INTO auth_challenges(id,user_id,kind,token_hash,payload,expires_at) VALUES(?,?,?,?,?,?)",cid,user,kind,hash(token),"{}",after(expiry));a.db.update("INSERT INTO auth_mail_outbox(id,challenge_id,recipient,kind,token_cipher,status,created_at) VALUES(?,?,?,?,?,?,?)",id(),cid,recipient,kind,a.crypt(token,true),testMailSink?"CAPTURED_TEST":"PENDING",now());}
 ObjectNode requestMail(HttpServletRequest req,JsonNode b,boolean reset){a.web(req,true,false);check(mailConfigured(),503,"EMAIL_PROVIDER_NOT_CONFIGURED");String em=email(text(b,"email"));var row=a.one("SELECT * FROM users WHERE email=? FOR UPDATE",em);String kind=reset?"PASSWORD_RESET":"EMAIL_VERIFY";
  // Same response/rate gate for unknown accounts; throttle contains only hashes, never a mailbox/token.
  mailRate.admit(hash(em),System.currentTimeMillis());if(row!=null){long user=((Number)row.get("id")).longValue();if(reset?a.one("SELECT id FROM auth_identities WHERE user_id=? AND provider='EMAIL'",user)!=null:!Boolean.TRUE.equals(row.get("email_verified")))mail(user,em,kind,reset?1800:86400);}return a.obj("accepted",true);}
 Map<String,Object> token(JsonNode b,String kind){var c=a.one("SELECT * FROM auth_challenges WHERE token_hash=? AND kind=? FOR UPDATE",hash(text(b,"token")),kind);check(c!=null&&future(c.get("expires_at")),410,"TOKEN_EXPIRED");check(c.get("consumed_at")==null,409,"USED_TOKEN");return c;}
 ObjectNode verify(JsonNode b){var c=token(b,"EMAIL_VERIFY");a.db.update("UPDATE auth_challenges SET consumed_at=? WHERE id=?",now(),c.get("id"));a.db.update("UPDATE users SET email_verified=true,status='ACTIVE' WHERE id=?",c.get("user_id"));return a.obj("verified",true);}
 ObjectNode reset(JsonNode b){password(text(b,"new_password"));var c=token(b,"PASSWORD_RESET");long user=((Number)c.get("user_id")).longValue();a.db.update("UPDATE users SET auth_version=auth_version+1 WHERE id=?",user);a.db.update("UPDATE auth_challenges SET consumed_at=? WHERE id=?",now(),c.get("id"));a.db.update("UPDATE auth_identities SET password_hash=?,updated_at=? WHERE user_id=? AND provider='EMAIL'",a.passwords.encode(text(b,"new_password")),now(),user);a.db.update("DELETE FROM web_sessions WHERE user_id=?",user);a.db.update("UPDATE extension_tokens SET revoked_at=COALESCE(revoked_at,?) WHERE user_id=?",now(),user);return null;}
 ObjectNode reauthenticate(HttpServletRequest req,JsonNode b){var w=a.web(req,true,true);var row=a.one("SELECT password_hash FROM auth_identities WHERE user_id=? AND provider='EMAIL'",w.get("user_id"));check(row!=null&&a.passwords.matches(text(b,"password"),row.get("password_hash").toString()),401,"INVALID_CREDENTIALS");a.db.update("UPDATE web_sessions SET reauthenticated_at=? WHERE id_hash=?",now(),w.get("id_hash"));return null;}
 ObjectNode disconnect(Identity i,String ex){uuid(ex);var row=a.one("SELECT * FROM extension_installations WHERE id=? AND current_user_id=? FOR UPDATE",ex,i.user());check(row!=null,404,"INSTALLATION_NOT_FOUND");check(i.executor()==null||i.executor().equals(ex),403,"EXECUTOR_MISMATCH");check(a.one("SELECT user_id FROM active_execution_locks WHERE executor_id=?",ex)==null,409,"RELEASE_UNCONFIRMED");a.db.update("UPDATE extension_tokens SET revoked_at=COALESCE(revoked_at,?) WHERE executor_id=? AND user_id=?",now(),ex,i.user());a.db.update("UPDATE extension_installations SET current_user_id=NULL WHERE id=?",ex);return null;}
 ObjectNode logout(HttpServletRequest req,HttpServletResponse res){var w=a.web(req,true,true);long user=((Number)w.get("user_id")).longValue();check(a.one("SELECT user_id FROM active_execution_locks WHERE user_id=?",user)==null,409,"ACTIVE_EXECUTION_OR_LINK");if(w.get("logout_executor_id")!=null)check(a.one("SELECT id FROM extension_installations WHERE id=? AND current_user_id=?",w.get("logout_executor_id"),user)==null,409,"ACTIVE_EXECUTION_OR_LINK");a.db.update("DELETE FROM web_sessions WHERE id_hash=?",w.get("id_hash"));res.addHeader("Set-Cookie","FOCURVE_WEB=; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=0");return null;}
}
