@Profile("member-runtime | local-integration") @Component
class MemberPolicy {
 final MemberAuth a;final MemberExecution e;MemberPolicy(MemberAuth a,MemberExecution e){this.a=a;this.e=e;}
 ObjectNode get(Identity i){var row=a.one("SELECT * FROM content_policies WHERE user_id=? FOR UPDATE",i.user());if(row==null){new MemberAccounts(a).defaults(i.user());row=a.one("SELECT * FROM content_policies WHERE user_id=?",i.user());}ObjectNode p=e.parse(row.get("payload"));p.put("version",((Number)row.get("version")).longValue());p.put("updated_at",instant(row.get("updated_at")));return p;}
 static void hosts(JsonNode rows){check(rows.isArray()&&rows.size()<=500,422,"INVALID_SCOPE");Set<String>seen=new HashSet<>();for(JsonNode row:rows){keys(row,"host","include_subdomains");String h=text(row,"host");check(h.equals(MemberSites.host(h))&&!h.contains("://")&&!h.contains("/")&&row.path("include_subdomains").isBoolean()&&seen.add(h+":"+row.path("include_subdomains")),422,"INVALID_SCOPE");}}
 static void validate(JsonNode p){keys(p,"keywords","adult_domains","image_blur","usage_tracking");for(String k:List.of("keywords","adult_domains","image_blur","usage_tracking"))check(p.path(k).isObject()&&p.path(k).path("enabled").isBoolean(),422,"VALIDATION_FAILED");var k=p.path("keywords");keys(k,"enabled","rules","exceptions");check(k.path("rules").isArray()&&k.path("rules").size()<=200,422,"VALIDATION_FAILED");Set<String>ids=new HashSet<>(),texts=new HashSet<>();for(JsonNode r:k.path("rules")){keys(r,"id","text","scopes");uuid(text(r,"id"));String text=text(r,"text").trim();check(ids.add(text(r,"id"))&&text.length()>=1&&text.length()<=80&&texts.add(java.text.Normalizer.normalize(text,java.text.Normalizer.Form.NFKC).toLowerCase(Locale.ROOT))&&r.path("scopes").isArray()&&!r.path("scopes").isEmpty(),422,"VALIDATION_FAILED");Set<String>scopes=new HashSet<>();for(JsonNode s:r.path("scopes"))check(Set.of("TITLE","URL","BODY").contains(s.asText())&&scopes.add(s.asText()),422,"INVALID_SCOPE");}hosts(k.path("exceptions"));var adult=p.path("adult_domains");keys(adult,"enabled","custom_hosts","exceptions");hosts(adult.path("custom_hosts"));hosts(adult.path("exceptions"));var blur=p.path("image_blur");keys(blur,"enabled","sensitivity","strength");check(Set.of("LOW","MEDIUM","HIGH").contains(text(blur,"sensitivity"))&&Set.of("LOW","MEDIUM","HIGH").contains(text(blur,"strength")),422,"VALIDATION_FAILED");keys(p.path("usage_tracking"),"enabled");}
 ObjectNode put(Identity i,JsonNode p,String etag){e.ownerLock(i);ObjectNode old=get(i);MemberSites.version(etag,old.path("version").asLong());validate(p);long version=old.path("version").asLong()+1;ObjectNode next=p.deepCopy();next.put("version",version);a.db.update("UPDATE content_policies SET version=?,payload=?,updated_at=?,keywords=?,adult_domains=?,image_blur=?,usage_tracking=? WHERE user_id=?",version,next.toString(),now(),p.path("keywords").toString(),p.path("adult_domains").toString(),p.path("image_blur").toString(),p.path("usage_tracking").toString(),i.user());return get(i);}
