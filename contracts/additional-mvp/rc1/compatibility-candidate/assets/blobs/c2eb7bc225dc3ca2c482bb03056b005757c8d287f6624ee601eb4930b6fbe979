-- Independent MEMBER_A1_CONFIRMED_1 experiment. Never run against a product database.
CREATE TABLE auth_identities(id BIGINT PRIMARY KEY AUTO_INCREMENT,user_id BIGINT NOT NULL,provider VARCHAR(16) NOT NULL,subject VARCHAR(255) COLLATE utf8mb4_0900_bin NOT NULL,password_hash VARCHAR(255),updated_at DATETIME(3) NOT NULL,UNIQUE(provider,subject),FOREIGN KEY(user_id) REFERENCES users(id));
CREATE TABLE web_sessions(id_hash CHAR(64) PRIMARY KEY,user_id BIGINT NULL,csrf_hash CHAR(64) NOT NULL,expires_at DATETIME(3) NOT NULL,FOREIGN KEY(user_id) REFERENCES users(id));
CREATE TABLE extension_installations(id CHAR(36) PRIMARY KEY,current_user_id BIGINT NULL,proof_hash CHAR(64) NOT NULL,client_version VARCHAR(40) NOT NULL,last_seen_at DATETIME(3),FOREIGN KEY(current_user_id) REFERENCES users(id));
CREATE TABLE link_requests(id CHAR(36) PRIMARY KEY,executor_id CHAR(36) NOT NULL,approved_user_id BIGINT NULL,code_challenge VARCHAR(128) COLLATE utf8mb4_0900_bin NOT NULL,callback_uri VARCHAR(2048) NOT NULL,state_hash CHAR(64) NOT NULL,code_hash CHAR(64),code_cipher TEXT,execution_evidence JSON,expires_at DATETIME(3) NOT NULL,code_expires_at DATETIME(3),consumed_at DATETIME(3),FOREIGN KEY(executor_id) REFERENCES extension_installations(id),FOREIGN KEY(approved_user_id) REFERENCES users(id));
CREATE TABLE extension_tokens(id CHAR(36) PRIMARY KEY,executor_id CHAR(36) NOT NULL,user_id BIGINT NOT NULL,refresh_hash CHAR(64) UNIQUE NOT NULL,access_hash CHAR(64) UNIQUE NOT NULL,family_id CHAR(36) NOT NULL,expires_at DATETIME(3) NOT NULL,access_expires_at DATETIME(3) NOT NULL,revoked_at DATETIME(3),FOREIGN KEY(executor_id) REFERENCES extension_installations(id),FOREIGN KEY(user_id) REFERENCES users(id));
CREATE TABLE policy_snapshots(id CHAR(36) PRIMARY KEY,user_id BIGINT NOT NULL,executor_id CHAR(36) NOT NULL,format_version VARCHAR(8) NOT NULL,payload JSON NOT NULL,payload_hash CHAR(64) NOT NULL,created_at DATETIME(3) NOT NULL,UNIQUE(id,user_id,executor_id),FOREIGN KEY(user_id) REFERENCES users(id),FOREIGN KEY(executor_id) REFERENCES extension_installations(id));
CREATE TABLE focus_sessions(id BIGINT PRIMARY KEY AUTO_INCREMENT,source_session_id CHAR(36) NOT NULL UNIQUE,user_id BIGINT NOT NULL,executor_id CHAR(36) NOT NULL,policy_snapshot_id CHAR(36) NOT NULL,execution_status VARCHAR(24) NOT NULL,duration_minutes INT NOT NULL,desired_revision BIGINT NOT NULL,body JSON NOT NULL,UNIQUE(id,user_id,executor_id),FOREIGN KEY(policy_snapshot_id,user_id,executor_id) REFERENCES policy_snapshots(id,user_id,executor_id),CHECK(duration_minutes BETWEEN 1 AND 180));
CREATE TABLE active_execution_locks(user_id BIGINT PRIMARY KEY,executor_id CHAR(36) NOT NULL UNIQUE,session_id BIGINT NOT NULL UNIQUE,revision BIGINT NOT NULL,FOREIGN KEY(session_id,user_id,executor_id) REFERENCES focus_sessions(id,user_id,executor_id));
CREATE TABLE execution_commands(id CHAR(36) PRIMARY KEY,session_id BIGINT NOT NULL,executor_id CHAR(36) NOT NULL,desired_revision BIGINT NOT NULL,kind VARCHAR(24) NOT NULL,payload JSON NOT NULL,status VARCHAR(20) NOT NULL,created_at DATETIME(3) NOT NULL,execute_before DATETIME(3),UNIQUE(session_id,desired_revision,kind),FOREIGN KEY(session_id) REFERENCES focus_sessions(id),FOREIGN KEY(executor_id) REFERENCES extension_installations(id));
CREATE TABLE execution_reports(id CHAR(36) PRIMARY KEY,session_id BIGINT NOT NULL,command_id CHAR(36),executor_id CHAR(36) NOT NULL,desired_revision BIGINT NOT NULL,payload_hash CHAR(64) NOT NULL,result VARCHAR(24) NOT NULL,observed_at DATETIME(3) NOT NULL,payload LONGTEXT NOT NULL,FOREIGN KEY(session_id) REFERENCES focus_sessions(id),FOREIGN KEY(command_id) REFERENCES execution_commands(id),FOREIGN KEY(executor_id) REFERENCES extension_installations(id));
CREATE TABLE session_intervals(id CHAR(36) PRIMARY KEY,session_id BIGINT NOT NULL,kind VARCHAR(8) NOT NULL,start_at DATETIME(3) NOT NULL,end_at DATETIME(3),duration_ms BIGINT,quality VARCHAR(20) NOT NULL,confirmed_until DATETIME(3) NOT NULL,payload JSON NOT NULL,FOREIGN KEY(session_id) REFERENCES focus_sessions(id));
CREATE TABLE local_execution_actions(id CHAR(36) PRIMARY KEY,session_id BIGINT NOT NULL,seq BIGINT NOT NULL,payload_hash CHAR(64) NOT NULL,payload LONGTEXT NOT NULL,UNIQUE(session_id,seq),FOREIGN KEY(session_id) REFERENCES focus_sessions(id));
CREATE TABLE idempotency_keys(owner_key VARCHAR(120) NOT NULL,method VARCHAR(10) NOT NULL,path VARCHAR(255) NOT NULL,request_key CHAR(36) NOT NULL,body_hash CHAR(64) NOT NULL,response JSON NOT NULL,expires_at DATETIME(3) NOT NULL,PRIMARY KEY(owner_key,method,path,request_key));
CREATE TABLE operations(id CHAR(36) PRIMARY KEY,user_id BIGINT NOT NULL,resource_id CHAR(36) NOT NULL,status VARCHAR(20) NOT NULL,created_at DATETIME(3) NOT NULL,FOREIGN KEY(user_id) REFERENCES users(id));
CREATE TABLE event_receipts(event_id CHAR(36) PRIMARY KEY,owner_user_id BIGINT NOT NULL,executor_id CHAR(36) NOT NULL,resolved_session_id BIGINT NOT NULL,schema_version VARCHAR(8) NOT NULL,event_type VARCHAR(40) NOT NULL,payload_hash CHAR(64) NOT NULL,payload LONGTEXT NOT NULL,status VARCHAR(24) NOT NULL,local_seq BIGINT NOT NULL,received_at DATETIME(3) NOT NULL,UNIQUE(resolved_session_id,local_seq),FOREIGN KEY(resolved_session_id,owner_user_id,executor_id) REFERENCES focus_sessions(id,user_id,executor_id));
CREATE TABLE access_events(event_id CHAR(36) PRIMARY KEY,session_id BIGINT NOT NULL,occurred_at DATETIME(3) NOT NULL,access_seq BIGINT NOT NULL,target_kind VARCHAR(16) NOT NULL,target_host VARCHAR(253) NOT NULL,target_key VARCHAR(320) NOT NULL,reason VARCHAR(40) NOT NULL,navigation_id CHAR(36) NOT NULL,policy_snapshot_id CHAR(36) NOT NULL,UNIQUE(session_id,access_seq),UNIQUE(session_id,navigation_id,target_key),FOREIGN KEY(event_id) REFERENCES event_receipts(event_id),FOREIGN KEY(session_id) REFERENCES focus_sessions(id),FOREIGN KEY(policy_snapshot_id) REFERENCES policy_snapshots(id));
