# Local development only. Copy to .env and enter your own values. Never commit .env.
MYSQL_PORT=3306
DB_USERNAME=focurve
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_URL="jdbc:mysql://127.0.0.1:3306/focurve?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
# Tests use a separate database. Never point this at production or shared data.
TEST_DB_URL="jdbc:mysql://127.0.0.1:3306/focurve_test?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
# Local HTTP only; HTTPS deployment must use true. Never expose this dev server publicly.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173
AUTH_PUBLIC_URL=http://127.0.0.1:5173
AUTH_SESSION_HOURS=24
# Server-only SMTP settings. Empty host/from => signup returns MAIL_UNAVAILABLE, not success.
MAIL_MODE=mailpit
MAIL_SSL=false
MAIL_HOST=
MAIL_PORT=1025
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TLS=false
# Server-only OAuth; register the exact callback URLs with each provider.
OAUTH_CALLBACK_BASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Exact registered Extension callback URIs; use the versioned linking contract in design/11.
EXTENSION_CALLBACK_URIS=

# Public Web configuration only. Vite must receive these through frontend/.env.local or its process environment.
VITE_MAIL_MODE=mailpit
VITE_DEV_MAILBOX_URL=http://127.0.0.1:8025
VITE_EXTENSION_ID=

# Keep OFF until actual Server/Core Snapshot 1.2 compatibility is verified per executor.
SNAPSHOT_1_2_ENABLED=false
SNAPSHOT_1_2_VERIFIED_EXECUTORS=
