<mxfile host="app.diagrams.net"><diagram id="pc-stages" name="개발 단계와 PC 확장"><mxGraphModel page="1" pageWidth="1400" pageHeight="740"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="FOCURVE 개발 단계와 PC 확장" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#7c91ad;fontColor=#182b49;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="30" width="1280" height="70" /></mxCell><mxCell id="a" value="1단계 · 필수 MVP&#10;Web · Server · Chrome Extension&#10;필수 33개 기능 구현·검증" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0ff;strokeColor=#7c91ad;fontColor=#182b49;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="150" width="370" height="150" /></mxCell><mxCell id="b" value="2단계 · 추가 MVP&#10;추가 14개 기능 구현&#10;필수 기능 회귀·전체 연동 검증" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f5f2;strokeColor=#7c91ad;fontColor=#182b49;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="150" width="370" height="150" /></mxCell><mxCell id="c" value="3단계 · PC 앱 확장&#10;PC 프로그램 관리·제어&#10;MVP 검증 후 PC 상세 설계·구현" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1eaff;strokeColor=#7c91ad;fontColor=#182b49;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="970" y="150" width="380" height="150" /></mxCell><mxCell id="scope" value="현재 상세 설계: Web 대시보드 ↔ Server·DB ↔ Chrome Extension&#10;현재 47개 기능과 상세 63페이지·요약 8페이지 유지" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf2f8;strokeColor=#7c91ad;fontColor=#182b49;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="390" width="1300" height="110" /></mxCell><mxCell id="future" value="후속 PC 앱: Web·Server 재사용과 연결 방식은 PC 상세 설계에서 검토&#10;PC 기술·지원 OS·일정·담당은 별도 수립 · 모바일은 미정" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1eaff;strokeColor=#7c91ad;fontColor=#182b49;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="560" width="1300" height="110" /></mxCell><mxCell id="e1" source="a" target="b" e