ime(3)" style="html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK KR;fontColor=#203248;spacingLeft=16;fontSize=19;fontColor=#66788B;spacingLeft=4;" vertex="1" parent="focus_sessions_anchor"><mxGeometry as="geometry" x="490" y="816" width="316" height="36" /></mxCell><mxCell id="focus_sessions_rowbg21" value="" style="fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="focus_sessions_anchor"><mxGeometry as="geometry" x="1" y="852" width="818" height="36" /></mxCell><mxCell id="focus_sessions_key21" value="" style="html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK KR;fontColor=#203248;spacingLeft=16;fontSize=18;fontStyle=1;fontColor=#247454;spacingLeft=12;" vertex="1" parent="focus_sessions_anchor"><mxGeometry as="geometry" x="0" y="852" width="90" height="36" /></mxCell><mxCell id="focus_sessions_field21" value="updated_at" style="html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK KR;fontColor=#203248;spacingLeft=16;fontSize=22;fontStyle=0;spacingLeft=2;" vertex="1" parent="focus_sessions_anchor"><mxGeometry as="geometry" x="94" y="852" width="388" height="36" /></mxCell><mxCell id="focus_sessions_type21" value="datetime(3)" style="html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK KR;fontColor=#203248;spacingLeft=16;fontSize=19;fontColor=#66788B;spacingLeft=4;" vertex="1" parent="focus_sessions_anchor"><mxGeometry as="geometry" x="490" y="852" width="316" height="36" /></mxCell><mxCell id="focus_sessions_uq0" value="UQ (executor_id, source_session_id)" style="html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK KR;fontColor=#203248;spacingLeft=16;fontSize=18;fontColor=#526475;whiteSpace=wrap;" vertex="1" parent="focus_sessions_anchor"><mxGeometry as="geometry" x="0" y="900" width="820" height="50" /></mxCell><mxCell id="rel17_card0" value="1"