d="rel19_card1" value="0..N" vertex="1" connectable="0" parent="rel19" style="edgeLabel;html=0;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Noto Sans CJK KR;fontColor=#172B3A;labelBackgroundColor=#FFFFFF;"><mxGeometry as="geometry" x="1" y="0" relative="1" width="70" height="28"><mxPoint as="offset" x="28" y="-94" /></mxGeometry></mxCell><mxCell id="rel18_card0" value="1" vertex="1" connectable="0" parent="rel18" style="edgeLabel;html=0;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Noto Sans CJK KR;fontColor=#172B3A;labelBackgroundColor=#FFFFFF;"><mxGeometry as="geometry" x="-1" y="0" relative="1" width="70" height="28"><mxPoint as="offset" x="45" y="-32" /></mxGeometry></mxCell><mxCell id="rel18_card1" value="0..N" vertex="1" connectable="0" parent="rel18" style="edgeLabel;html=0;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Noto Sans CJK KR;fontColor=#172B3A;labelBackgroundColor=#FFFFFF;"><mxGeometry as="geometry" x="1" y="0" relative="1" width="70" height="28"><mxPoint as="offset" x="-115" y="-32" /></mxGeometry></mxCell><mxCell id="rel20_card0" value="0..1" vertex="1" connectable="0" parent="rel20" style="edgeLabel;html=0;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Noto Sans CJK KR;fontColor=#172B3A;labelBackgroundColor=#FFFFFF;"><mxGeometry as="geometry" x="-1" y="0" relative="1" width="70" height="28"><mxPoint as="offset" x="-115" y="-32" /></mxGeometry></mxCell><mxCell id="rel20_card1" value="0..N" vertex="1" connectable="0" parent="rel20" style="edgeLabel;html=0;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Noto Sans CJK KR;fontColor=#172B3A;labelBackgroundColor=#FFFFFF;"><mxGeometry as="geometry" x="1" y="0" relative="1" width="70" height="28"><mxPoint as="offset" x="45" y="-32" /></m