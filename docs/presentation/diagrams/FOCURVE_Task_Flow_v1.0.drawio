        <mxCell id="18:1329" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Inter,Noto Sans CJK KR,Malgun Gothic,sans-serif;fontSize=16;fontColor=#1e1e1e;align=center;verticalAlign=middle;spacing=8;strokeWidth=4;fillColor=#ffffff;strokeColor=#757575;shape=process;size=0.08;" value="정책 적용 상태부터 재확인" vertex="1">
