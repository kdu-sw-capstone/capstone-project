        <mxCell id="wrvYEf57pqpJ_9vhymzj-26" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Inter,Noto Sans CJK KR,Malgun Gothic,sans-serif;fontSize=16;fontColor=#1e1e1e;align=center;verticalAlign=middle;spacing=8;strokeWidth=4;fillColor=#ffffff;strokeColor=#757575;shape=process;size=0.08;" value="미완료 항목만 가져오기 재시도" vertex="1">
