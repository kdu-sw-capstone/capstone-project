        <mxCell id="qfVdrBZmJM2ZySM87WYW-30" edge="1" parent="1" source="qfVdrBZmJM2ZySM87WYW-21" style="html=0;whiteSpace=wrap;fontFamily=Inter,Noto Sans CJK KR,Malgun Gothic,sans-serif;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;strokeWidth=4;strokeColor=#757575;rounded=1;arcSize=24;endArrow=open;startArrow=none;endSize=12;startSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;edgeStyle=orthogonalEdgeStyle;jettySize=40;" target="qfVdrBZmJM2ZySM87WYW-29" value="">
