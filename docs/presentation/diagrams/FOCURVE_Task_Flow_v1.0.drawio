        <mxCell id="dAx50jfBPeVpGSyK3GUD-42" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Inter,Noto Sans CJK KR,Malgun Gothic,sans-serif;fontSize=16;fontColor=#1e1e1e;align=center;verticalAlign=middle;spacing=8;strokeWidth=4;fillColor=#ffffff;strokeColor=#757575;shape=process;size=0.08;" value="확장 계정 연결 확인으로 복귀" vertex="1">
